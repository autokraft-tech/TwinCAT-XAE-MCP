{
  "mcpServers": {
    "nexplc_xae": {
      "disabled": true,
      "command": "<NODE_EXE>",
      "args": [
        "<MCP_REPOSITORY>/index.js"
      ],
      "env": {
        "TE1000_DAEMON_EXE": "<DAEMON_EXE>",
        "TE1000_DAEMON_PIPE": "nexplc-readonly-example",
        "TE1000_SESSION_MODE": "createOnce",
        "TE1000_MCP_SOLUTION_PATH": "<SOLUTION>",
        "TE1000_PROJECT_NAME": "<SYSTEM_MANAGER_PROJECT>",
        "TE1000_PLC_ROOT": "<PLC_ROOT>",
        "TE1000_DIALOG_AUTODISMISS": "0",
        "TE1000_WRITE_SOLUTION_PATH": "",
        "TE1000_WRITE_ROOTS": ""
      }
    }
  }
}
